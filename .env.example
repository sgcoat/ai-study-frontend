# 앱에 노출되어도 안전한 백엔드 주소만 설정합니다. 비밀 키는 여기에 넣지 마세요.
EXPO_PUBLIC_API_BASE_URL=https://jqhivsrfrkycfjefgoam.supabase.co/functions/v1/ai-study-api/api/v1
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_APP_ENV=development
# 개인정보 처리방침을 게시한 후 실제 HTTPS 주소를 입력합니다.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# EAS 빌드 설정: 공개 식별자이며 서버 비밀 값이 아닙니다.
APP_IOS_BUNDLE_IDENTIFIER=com.sgcoat.aistudy
APP_ANDROID_PACKAGE=com.sgcoat.aistudy
EAS_PROJECT_ID=c86eab15-d82d-4b8e-994b-c0768126fe08
# 로컬 백엔드 연결: pnpm server:connect (루트 .env에 http 모드와 LAN 주소를 설정)
# Supabase 클라우드 연결 및 Expo 실행: pnpm dev:cloud
# 요약 mock 작업은 기본 6초 후 완료됩니다. 실패 UI 확인 시 true로 바꿉니다.
EXPO_PUBLIC_MOCK_SUMMARY_DELAY_MS=6000
EXPO_PUBLIC_MOCK_SUMMARY_FAIL_ONCE=false
# 문제 mock 작업도 기본 6초 후 완료됩니다.
EXPO_PUBLIC_MOCK_QUESTION_DELAY_MS=6000
EXPO_PUBLIC_MOCK_QUESTION_FAIL_ONCE=false
