{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "base": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_API_MODE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://jqhivsrfrkycfjefgoam.supabase.co/functions/v1/ai-study-api/api/v1"
      }
    },
    "preview": {
      "extends": "base",
      "android": { "buildType": "apk" }
    },
    "preview-ios-simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_API_MODE": "http" },
      "android": { "buildType": "app-bundle" }
    }
  }
}
